{
  "name": "MarketCache",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cache key, e.g. 'liveQuotes' or 'newsHeadlines'"
    },
    "payload": {
      "type": "string",
      "description": "JSON stringified cached data"
    },
    "fetched_at": {
      "type": "string",
      "description": "ISO timestamp of when this was last fetched"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}