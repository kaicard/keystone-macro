{
  "name": "NewsletterSubscription",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Subscriber email"
    },
    "name": {
      "type": "string",
      "description": "Subscriber name"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "past_due",
        "pending"
      ],
      "default": "pending"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topic preferences"
    }
  },
  "required": [
    "email"
  ]
}