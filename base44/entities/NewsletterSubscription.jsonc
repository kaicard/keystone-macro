{
  "name": "NewsletterSubscription",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Subscriber email"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user ID linked to this subscription"
    },
    "name": {
      "type": "string",
      "description": "Subscriber name"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "past_due",
        "pending",
        "cancelling"
      ],
      "default": "pending"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topic preferences"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "Stripe subscription period end"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}